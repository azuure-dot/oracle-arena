{
  "name": "hero-shooter-server",
  "private": true,
  "version": "0.1.0",
  "description": "Serveur multijoueur autoritaire du Hero Shooter (salons privés, Socket.io).",
  "main": "dist/server/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.0"
  }
}
